# CodeOrbit Environment Configuration Example

# Application URL & Port
APP_URL="http://localhost:3000"
PORT=3000

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend API Key for Automated Email Reminders
RESEND_API_KEY="your-resend-api-key"
# Optional: Verified domain sender in Resend to deliver to all user emails (e.g. "CodeOrbit <reminders@yourdomain.com>")
RESEND_FROM_EMAIL="CodeOrbit <onboarding@resend.dev>"

# Optional: SMTP Configuration (e.g. Gmail App Password) to deliver to ALL registered user emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
